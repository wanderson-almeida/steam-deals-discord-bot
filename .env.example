# Required
DISCORD_BOT_TOKEN=
NOTIFY_CHANNEL_ID=

# Optional: guild id for instant slash command sync (recommended while testing)
GUILD_ID=

# Monitoring
CHECK_INTERVAL_MINUTES=30
MAX_CONCURRENCY=5
MAX_NOTIFICATIONS_PER_CYCLE=20
# false = only base games (category1=998), true = also DLC, software, etc.
INCLUDE_NON_GAMES=false

# Storage
DATABASE_PATH=data/steamdeals.db

# Steam store region / language
STEAM_COUNTRY=br
STEAM_LANGUAGE=brazilian

LOG_LEVEL=INFO
